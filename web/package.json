{
  "name": "paperless-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./dev.ts",
    "build": "tsc --noEmit && bun run ./build.ts",
    "test": "bun test",
    "lint": "biome lint --error-on-warnings .",
    "fmt": "biome format --write .",
    "fmt:check": "biome format ."
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
